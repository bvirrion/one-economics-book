# Build output
build/

# Version stamp generated by the release workflow (see .github/workflows/release.yml)
version.tex

# LaTeX intermediate files (in case of out-of-tree builds)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.log
*.out
*.synctex.gz
*.toc

.venv/
**/__pycache__/
tools/htmlbook/node_modules/


# Raw downloads (tools/fetch_data.py fetch); only data/derived/ is kept
data/raw/

# Local drafts and comparisons (not part of the books)
draft/

# Compiled listings and Rust build trees
code/**/target/
code/**/bin/

.pytest_cache/
.ruff_cache/

# Derived tables (tools/derive_data.py, ~0.9 GB); rebuilt from data/raw/
data/derived/

# Run-time files of the usage watcher (main session)
sources/PAUSE
sources/usage_watch.pid
sources/usage_watch.log
