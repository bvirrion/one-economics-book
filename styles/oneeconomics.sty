% Decoration: colored left rule + light background.
% "lines before break" forces boxes with no room for their first lines to
% move to the next page instead of attempting a zero-height first part,
% which would silently discard any \label written there. (Raised from 3
% to 5 after a recurrence: a box starting very close to the page bottom
% could still produce a discarded zero-height first part. If a label that
% plainly exists still reports as undefined, move it to just before the
% environment's \end -- the counter is unchanged and the write survives.)
% The coloured rule marks the edge a reader starts from, so it follows the
% script: west for the left-to-right editions, east for Arabic, with the
% asymmetric padding mirrored to match. The two option lists are written out
% in full rather than assembled from a macro: pgfkeys does not expand a macro
% while parsing key names, and a \om@statementrule{...} in there is read as
% one long unknown key ("I do not know the key '/tcb/borderline west=...'").
\ifom@arabic
\newcommand{\omdecorate}[3][]{%
  \tcolorboxenvironment{#2}{%
    enhanced jigsaw, breakable, frame hidden,
    boxrule=0pt, sharp corners,
    borderline east={2pt}{0pt}{#3},
    left=4pt, right=8pt, top=4pt, bottom=4pt,
    before skip=10pt, after skip=10pt,
    lines before break=5,
    colback=#3!4!white,#1}%
}
\else
\newcommand{\omdecorate}[3][]{%
  \tcolorboxenvironment{#2}{%
    enhanced jigsaw, breakable, frame hidden,
    boxrule=0pt, sharp corners,
    borderline west={2pt}{0pt}{#3},
    left=8pt, right=4pt, top=4pt, bottom=4pt,
    before skip=10pt, after skip=10pt,
    lines before break=5,
    colback=#3!4!white,#1}%
}
\fi
\omdecorate{definition}{omDef}
\omdecorate{theorem}{omThm}
\omdecorate{proposition}{omProp}
\omdecorate{lemma}{omProp}
\omdecorate{corollary}{omProp}
\omdecorate{method}{omMeth}
\omdecorate{exercise}{omExo}

% Every weekend problem starts on a fresh page (user ruling, 2026-10-26).
% The box is breakable, but tcolorbox needs `lines before break' of it to
% fit, so a problem that could not start at the foot of a page used to move
% on and leave its \section heading stranded above blank space, sometimes
% alone on a page. A problem with its own heading breaks the page BEFORE that
% heading: \section looks ahead, past blank lines, for \begin{problem}. A
% problem with no heading of its own (it follows the last exercise) breaks
% the page right before its box. No chapter file changes, in any language.
\newif\ifom@problemsec
\let\om@origsection\section
\renewcommand{\section}{\@ifstar
  {\om@sec@grab{\om@origsection*}}%
  {\@ifnextchar[{\om@sec@opt}{\om@sec@grab{\om@origsection}}}}
\def\om@sec@opt[#1]{\om@sec@grab{\om@origsection[#1]}}
\long\def\om@sec@grab#1#2{%
  \def\om@sec@emit{#1{#2}}\let\om@sec@pars\@empty\om@sec@peek}
\def\om@sec@peek{\@ifnextchar\par{\om@sec@eatpar}%
  {\@ifnextchar\begin{\om@sec@checkbegin}{\om@sec@emit\om@sec@pars}}}
\def\om@sec@eatpar\par{\def\om@sec@pars{\par}\om@sec@peek}
\def\om@str@problem{problem}
\def\om@sec@checkbegin\begin#1{%
  \def\om@tmp{#1}%
  \ifx\om@tmp\om@str@problem\clearpage\global\om@problemsectrue\fi
  \om@sec@emit\om@sec@pars\begin{#1}}
\BeforeBeginEnvironment{problem}{%
  \ifom@problemsec\global\om@problemsecfalse\@nobreakfalse\else\clearpage\fi}
% Decorate AFTER the hook above: tcolorbox wraps the environment through the
% same before-hook, and a \clearpage run inside an already-open box leaves a
% discarded zero-height first part ("Discard zero height first box part").
% A problem may split after its first two lines: with the default five, a
% box whose text before its first figure is shorter moves on whole and leaves
% its heading alone at the top of the fresh page.
\omdecorate[lines before break=2]{problem}{omExo}

