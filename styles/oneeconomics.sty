% ----------------------------------------------------------------------------
% Chart and diagram styles for the series. Use them before inventing new ones.
%
% pgfplots (charts from data; \begin{axis}[omtime, ...]):
%   omrecord   -- base style: bottom/left axes, light major grid
%   omtime     -- a time series: years on x printed without a thousands space
%   omtimesten -- the "times-ten scale" of grades 6--11: y on a logarithmic axis
%                 whose labels are plain numbers (1, 10, 100, 1000); from grade 12
%                 the same axis is called a logarithmic scale. Use it with
%                 \begin{semilogyaxis}[omtimesten, ...] (pgfplots reads xmode/ymode
%                 before it expands styles, so a style cannot set them)
%   omscatter  -- a cross-section of countries: marks only, small dots
%   omincomex  -- x = income per person on a times-ten axis (scatter against
%                 income): \begin{semilogxaxis}[omincomex, ...]
% TikZ (diagrams of models; \begin{tikzpicture}[econ]):
%   econ axes  -- \draw[econ axes] (0,5) |- (6,0); arrows on both axes
%   demand, supply -- the curves (blue, red), thick
%   curve      -- any other curve (black, thick); shifted -- a moved curve (dashed)
%   guide      -- dotted guide lines from a point to the axes
%   eqpoint    -- a filled point at an equilibrium
%   cs area, ps area, dwl area, tax area -- consumer surplus (blue tint),
%                 producer surplus (red tint), deadweight loss (grey hatch),
%                 tax revenue (yellow tint)
%   ppf        -- a production possibility frontier
%   phase arrow -- the direction of motion in a phase diagram
%   payoff     -- a payoff cell of a game in normal form (\node[payoff]{3, 1};)
% Game trees: forest. Edgeworth boxes: two econ axes, the second rotated 180°.
% ----------------------------------------------------------------------------
\pgfplotsset{/pgf/number format/1000 sep={\,}}
\pgfplotsset{
  omrecord/.style={axis x line=bottom, axis y line=left, axis line style={-}, grid=major,
    grid style={gray!22, line width=0.3pt},
    every axis label/.append style={font=\small},
    tick label style={font=\small}, legend style={font=\footnotesize, draw=none,
      fill=white, fill opacity=0.85, text opacity=1}, legend cell align=left,
    legend pos=north west,
    width=0.85\linewidth, height=0.5\linewidth, cycle list name=omcycle,
    scaled ticks=false},
  omtime/.style={omrecord,
    x tick label style={/pgf/number format/.cd, fixed, precision=0, 1000 sep=}},
  omtimesten/.style={omtime, log basis y=10, log ticks with fixed point,
    ytickten={-3,...,9}, log origin=infty},
  omscatter/.style={omrecord, only marks, cycle list={{omDef, mark=*, mark size=1.2pt},
    {omThm, mark=square*, mark size=1.1pt}, {omMeth, mark=triangle*, mark size=1.4pt},
    {omProp, mark=diamond*, mark size=1.4pt}}},
  omincomex/.style={omscatter, log basis x=10, log ticks with fixed point,
    xtickten={-3,...,9}},
}
\pgfplotscreateplotcyclelist{omcycle}{%
  {omDef, thick}, {omThm, thick}, {omMeth, thick}, {omProp, thick},
  {omDebate, thick}, {omExo, thick, dashed}, {omModel, thick, dashdotted}}
\tikzset{
  econ/.style={font=\small, >={Stealth[length=2mm]}},
  econ axes/.style={<->, thick, black!80},
  demand/.style={omDef, very thick},
  supply/.style={omThm, very thick},
  curve/.style={black, very thick},
  shifted/.style={very thick, dashed},
  guide/.style={densely dotted, black!60},
  eqpoint/.style={circle, fill=black, inner sep=0pt, minimum size=4pt},
  cs area/.style={fill=omDef!14, draw=none},
  ps area/.style={fill=omThm!14, draw=none},
  dwl area/.style={pattern={Lines[angle=45, distance=3pt, line width=0.4pt]},
    pattern color=black!45, draw=none},
  tax area/.style={fill=yellow!35, draw=none},
  ppf/.style={omMeth, very thick},
  phase arrow/.style={-{Stealth[length=2mm]}, thick, omProp},
  payoff/.style={draw, minimum width=16mm, minimum height=8mm, font=\small},
}
% amsthm's proof environment prints \proofname, which is English unless babel
% localises it — and babel is optional here (see above). Without this, a French
