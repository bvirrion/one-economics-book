% ----------------------------------------------------------------------------
% The boxes. Unnumbered, no label, and a defined term is never introduced
% inside one (\emph{..}\index{..} belongs in a definition).
%
%   model{Name}     -- the four-point frame every model gets, in this order:
%                        \begin{model}{Supply and demand}
%                          \assumes  ... \predicts ... \tested ... \breaks ...
%                        \end{model}
%                      (tools/check_boxes.py: all four, in order, once each)
%   debate[Title]   -- an open EMPIRICAL question: the competing estimates, each
%                      with its best study and its weaknesses. Never a
%                      normative debate, never a school of thought.
%   record[Title]   -- a dated episode used as a test of a model: what happened,
%                      what the model said, what that tells us.
%   measure[Title]  -- how a number is made (a price index, a poverty line, an
%                      unemployment survey, purchasing-power conversion).
%   recall          -- "You already know": opens a chapter that builds on a
%                      notion owned by an earlier chapter (\cref inside the same
%                      book) or another volume or series (named in prose); 3--5
%                      lines. Books 1 and 2 never re-teach a notion.
%   dated{2026}     -- volatile facts with the year they are given for; each
%                      has a ledger row.
% There is no history box (user ruling, 2026-11-19).
% ----------------------------------------------------------------------------
\definecolor{omRecall}{RGB}{88,98,120}
\definecolor{omDated}{RGB}{110,70,150}
\definecolor{omModel}{RGB}{0,110,120}
\definecolor{omDebate}{RGB}{150,70,110}
\definecolor{omRecord}{RGB}{135,96,45}
\definecolor{omMeasure}{RGB}{60,90,150}
