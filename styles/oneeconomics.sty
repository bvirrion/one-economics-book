% ----------------------------------------------------------------------------
% Charts drawn from data. Every chart reads a table written by a tested script
% (figdata/<year>/NN-<slug>/, CONTRIBUTING.md); none is drawn by hand, and no
% chart image is ever copied.
%   \begin{omchart}{Caption}{Source line}  <tikzpicture with an axis>  \end{omchart}
%   \begin{openingchart}{Caption}{Source line} ... \end{openingchart}
% openingchart is the chart that opens a chapter (one per chapter from grade 7;
% grade 6 chapters have three omcharts and no opening chart). The source line
% names the dataset as the Data Credits page does, e.g.
% "Maddison Project Database 2023; 1990 prices at purchasing-power parity".
% ----------------------------------------------------------------------------
\newcommand{\om@chartfoot}[2]{\par\smallskip{\small #1}\par
  {\footnotesize\itshape\color{black!70}\omnameSource: #2}}
\newenvironment{omchart}[2]
  {\def\om@chcap{#1}\def\om@chsrc{#2}\begin{omfigure}}
  {\om@chartfoot{\om@chcap}{\om@chsrc}\end{omfigure}}
\newenvironment{openingchart}[2]
  {\def\om@chcap{#1}\def\om@chsrc{#2}\begin{omfigure}}
  {\om@chartfoot{\om@chcap}{\om@chsrc}\end{omfigure}}

% ----------------------------------------------------------------------------
% Code listings. Code is NEVER pasted into a chapter: it is included from a
% tested file, and output is included from a file written only by
% tools/capture_output.py:
%   \omcode{code/grade-8/04-searching-and-sorting/binary_search.py}{1}{20}{Caption}\label{lst:g8:searching-and-sorting:bs}
%   \omcodes{path}{5-5,46-49}{Caption}\label{lst:...}   several ranges of one file
%   \omoutput{code/.../outputs/binary_search.txt}{Caption}\label{out:...}
%   \omoutput[1-1,10-18]{path}{Caption}                 only those lines
% The language is chosen from the file extension.
% ----------------------------------------------------------------------------
\RequirePackage{listings}
\RequirePackage{xstring}
\lstdefinelanguage{Rust}{%
  morekeywords={as,async,await,break,const,continue,crate,dyn,else,enum,extern,
    false,fn,for,if,impl,in,let,loop,match,mod,move,mut,pub,ref,return,self,Self,
    static,struct,super,trait,true,type,unsafe,use,where,while,
    u8,u16,u32,u64,u128,usize,i8,i16,i32,i64,i128,isize,f32,f64,bool,char,str,
    String,Vec,Option,Some,None,Result,Ok,Err,Box},
  sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/},
  morestring=[b]", }
\lstdefinestyle{om}{%
  basicstyle=\ttfamily\footnotesize, columns=fullflexible, keepspaces=true,
  keywordstyle=\color{omDef}\bfseries, commentstyle=\color{omMeth}\itshape,
  stringstyle=\color{omThm}, numberstyle=\tiny\color{omExo}, numbers=left,
  numbersep=6pt, xleftmargin=16pt, framexleftmargin=14pt,
  frame=l, framerule=2pt, rulecolor=\color{omCode},
  backgroundcolor=\color{omCode!4!white},
  showstringspaces=false, breaklines=true, breakatwhitespace=true,
  tabsize=4, upquote=true, aboveskip=6pt, belowskip=4pt,
  captionpos=b, literate={~}{{\textasciitilde}}1 {é}{{\'e}}1 {ê}{{\^e}}1 }
\lstset{style=om}
\RequirePackage{caption}
\captionsetup[lstlisting]{justification=raggedright,singlelinecheck=false,font=small}
\renewcommand{\lstlistingname}{\omnameListing}
\crefname{lstlisting}{\omnameListing}{\omnameListings}
\Crefname{lstlisting}{\omnameListing}{\omnameListings}
\newcommand{\om@lstlang}[1]{%
  \IfEndWith{#1}{.py}{\lstset{language=Python}}{%
  \IfEndWith{#1}{.c}{\lstset{language=C}}{%
  \IfEndWith{#1}{.h}{\lstset{language=C}}{%
  \IfEndWith{#1}{.rs}{\lstset{language=Rust}}{%
  \IfEndWith{#1}{.sh}{\lstset{language=bash}}{%
  \IfEndWith{#1}{.sql}{\lstset{language=SQL}}{%
  \IfEndWith{#1}{.s}{\lstset{language=[x86masm]Assembler}}{%
  \IfEndWith{#1}{.html}{\lstset{language=HTML}}{%
  \IfEndWith{#1}{.csv}{\lstset{language={}}}{%
  \IfEndWith{#1}{.txt}{\lstset{language={}}}{%
  \IfEndWith{#1}{.json}{\lstset{language={}}}{%
  \IfEndWith{#1}{.toml}{\lstset{language={}}}{%
  \IfEndWith{#1}{akefile}{\lstset{language=make}}{%
  \IfEndWith{#1}{.cpp}{\lstset{language=C++}}{%
  \IfEndWith{#1}{.hpp}{\lstset{language=C++}}{%
  \IfEndWith{#1}{.cc}{\lstset{language=C++}}{%
  \lstset{language={}}}}}}}}}}}}}}}}}}}
% #1 path, #2 first line, #3 last line, #4 caption; a \label may follow.
% A \label written right after \omcode{...} is absorbed and passed to listings
% as its label= key: listings typesets inside its own group, so a trailing
% \label would otherwise resolve to the enclosing section.
\newcommand{\omcode}[4]{%
  \def\om@code@args{{#1}{#2}{#3}{#4}}%
  \@ifnextchar\label{\om@code@withlabel}{\expandafter\om@code@do\om@code@args{}}}
\def\om@code@withlabel\label#1{\expandafter\om@code@do\om@code@args{label={#1},}}
\def\om@code@do#1#2#3#4#5{%
  \begingroup\om@lstlang{#1}%
  \lstinputlisting[firstline=#2,lastline=#3,firstnumber=#2,#5
    caption={#4\ \ {\scriptsize\ttfamily\color{omExo}\detokenize{#1}}}]{#1}%
  \endgroup}
\lstdefinestyle{omout}{style=om, language={}, numbers=none, frame=single, framerule=0.3pt,
  rulecolor=\color{black!35}, backgroundcolor=\color{black!5}, xleftmargin=4pt, framexleftmargin=3pt,
  basicstyle=\ttfamily\scriptsize, keywordstyle={}, commentstyle={}, stringstyle={}, breakatwhitespace=false,
  belowskip=0pt}
\newcounter{omout}[chapter]
\renewcommand{\theomout}{\thechapter.\arabic{omout}}
\newcommand{\om@out@range}{}
% the last line of a range list such as {1,8-20} or {3-5,9}: a lone number is
% its own end; an open end (8-) or anything odd means "to the end of the file"
\def\om@out@lastsplit#1-#2\relax{\def\om@tmpb{#2}%
  \ifx\om@tmpb\@empty\def\om@out@last{#1}\else\om@out@strip#2\relax\fi}
\def\om@out@strip#1-\relax{\def\om@out@last{#1}\ifx\om@out@last\@empty\def\om@out@last{99999}\fi}
\def\om@out@lastof#1{\def\om@out@last{99999}%
  \@for\om@r:=#1\do{\expandafter\om@out@lastsplit\om@r-\relax}}
\newcommand{\omoutput}[3][]{%
  \def\om@out@range{#1}%
  \def\om@out@args{{#2}{#3}}%
  \@ifnextchar\label{\om@out@withlabel}{\def\om@out@lab{}\expandafter\om@out@dolab\om@out@args}}
\def\om@out@withlabel\label#1{\def\om@out@lab{\label{#1}}\expandafter\om@out@dolab\om@out@args}
\def\om@out@dolab#1#2{%
  \par\smallskip\refstepcounter{omout}\om@out@lab
  \ifx\om@out@range\@empty
    \begingroup\def\om@lstendpen{10000}\lstinputlisting[style=omout, nolol=true]{#1}\endgroup
  \else
    % lastline= stops listings at the end of the last range: without it the
    % lines after that range still add blank lines at the foot of the frame
    \om@out@lastof{\om@out@range}%
    \edef\om@tmp{\noexpand\lstinputlisting[style=omout, nolol=true, linerange={\om@out@range}, lastline=\om@out@last]}%
    \begingroup\def\om@lstendpen{10000}\om@tmp{#1}\endgroup
  \fi
  \nobreak\vspace{1pt}{\noindent\footnotesize\textbf{\omnameOutput\ \theomout.}\ #2\ifx\om@out@range\@empty\else\ \omnameSomeLinesOut\fi\par}\smallskip}
\crefname{omout}{\omnameOutput}{\omnameOutputs}
\Crefname{omout}{\omnameOutput}{\omnameOutputs}
\def\om@lstendpen{-50}
\AtBeginDocument{\let\om@lst@frameExit\lst@frameExit
  \gdef\lst@frameExit{\par\nobreak\om@lst@frameExit}%
  \patchcmd{\lst@DeInit}{\par\penalty-50\vspace\lst@belowskip}{\par\penalty\om@lstendpen\vspace\lst@belowskip}{}%
    {\PackageWarning{oneeconomics}{could not patch \string\lst@DeInit: an output caption can open a page}}}
\newcommand{\omcodes}[3]{%
  \def\om@codes@args{{#1}{#2}{#3}}%
  \@ifnextchar\label{\om@codes@withlabel}{\expandafter\om@codes@do\om@codes@args{}}}
\def\om@codes@withlabel\label#1{\expandafter\om@codes@do\om@codes@args{label={#1},}}
\newcount\om@codes@n \newcount\om@codes@i
\def\om@codes@one#1#2#3#4{\lstinputlisting[firstline=#1,lastline=#2,firstnumber=#1,#4]{#3}}
\def\om@codes@split#1-#2\relax{\def\om@first{#1}\def\om@last{#2}}
\def\om@codes@do#1#2#3#4{%
  \begingroup\om@lstlang{#1}%
  \om@codes@n=0 \@for\om@r:=#2\do{\advance\om@codes@n by 1 }%
  \om@codes@i=0
  \@for\om@r:=#2\do{%
    \advance\om@codes@i by 1
    \expandafter\om@codes@split\om@r\relax
    \edef\om@tmp{\noexpand\om@codes@one{\om@first}{\om@last}}%
    \edef\om@skip{\ifnum\om@codes@i=1 6pt\else 0pt\fi}%
    \ifnum\om@codes@i<\om@codes@n
      \om@tmp{#1}{belowskip=0pt,aboveskip=\om@skip}\nointerlineskip
    \else
      \om@tmp{#1}{#4aboveskip=\om@skip,caption={#3\ \ {\scriptsize\ttfamily\color{omExo}\detokenize{#1}}}}%
    \fi}%
  \endgroup}
