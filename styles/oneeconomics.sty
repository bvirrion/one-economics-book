% ----------------------------------------------------------------------------
% Simplified Chinese (zh): the places where Chinese puts the number INSIDE the
% noun ("第3章", "第一部分", "练习 3.2 的解答（第 45 页）"), which no string in
% styles/lang/zh.tex can express because English puts the noun first. Nothing
% here runs for any other language.
% ----------------------------------------------------------------------------
\ifom@chinese
  \newcommand{\om@zhnum}[1]{\ifcase#1 〇\or 一\or 二\or 三\or 四\or 五\or 六\or
    七\or 八\or 九\or 十\or 十一\or 十二\or 十三\or 十四\or 十五\or 十六\or
    十七\or 十八\or 十九\or 二十\else\number#1\fi}
  % Chapter head: book.cls prints "\@chapapp\space\thechapter" on its own line.
  \patchcmd{\@makechapterhead}{\@chapapp\space \thechapter}{第\,\thechapter\,章}{}%
    {\PackageWarning{onechemistry}{zh: could not patch the chapter head}}%
  % Part head: "Part I" -> "第一部分" (hyperref keeps book.cls's \@part as
  % \H@old@part, which is where the words are).
  \patchcmd{\H@old@part}{\partname\nobreakspace\thepart}{第\om@zhnum{\value{part}}部分}{}%
    {\PackageWarning{onechemistry}{zh: could not patch the part head}}%
  % Solution header: "练习 3.2 的解答（第 45 页）".
  \renewenvironment{solution}[1]{%
    \par\medskip\om@solutionanchor{#1}%
    \textbf{\cref{#1}\omsolutionof}（第~\pageref{#1}~页）\par\nopagebreak\smallskip
    \noindent\ignorespaces
  }{\par\medskip}%
  % "Solution p. N" pointer -> "解答见第 N 页".
  \renewcommand{\omsollink@emit}{%
    \ifdefempty{\omsollink@key}{}{%
      \par\nopagebreak\smallskip
      \noindent\hfill{\footnotesize\itshape
        \hyperref[sol:\omsollink@key]{\omnameGotoSolution 第~\pageref{sol:\omsollink@key}~页}}%
      \par
    }%
  }%
  % \cref{ch:...} -> "第3章"; cleveref's English conjunctions -> 和、至.
  % Deferred to the end of begindocument for the reason given in the Arabic
  % block above: cleveref defines the conjunctions in its own hook.
  \AddToHook{begindocument/end}{%
    % A \cref inside math ((\text{proof in } \cref{exo:...}) in the canon)
    % sets its name in the math font, which has no Chinese glyph: wrap in \text.
    \crefname{definition}{\text{\omnameDefinition}}{\text{\omnameDefinitions}}%
    \Crefname{definition}{\text{\omnameDefinition}}{\text{\omnameDefinitions}}%
    \crefname{theorem}{\text{\omnameTheorem}}{\text{\omnameTheorems}}%
    \Crefname{theorem}{\text{\omnameTheorem}}{\text{\omnameTheorems}}%
    \crefname{proposition}{\text{\omnameProposition}}{\text{\omnamePropositions}}%
    \Crefname{proposition}{\text{\omnameProposition}}{\text{\omnamePropositions}}%
    \crefname{lemma}{\text{\omnameLemma}}{\text{\omnameLemmas}}%
    \Crefname{lemma}{\text{\omnameLemma}}{\text{\omnameLemmas}}%
    \crefname{corollary}{\text{\omnameCorollary}}{\text{\omnameCorollarys}}%
    \Crefname{corollary}{\text{\omnameCorollary}}{\text{\omnameCorollarys}}%
    \crefname{method}{\text{\omnameMethod}}{\text{\omnameMethods}}%
    \Crefname{method}{\text{\omnameMethod}}{\text{\omnameMethods}}%
    \crefname{example}{\text{\omnameExample}}{\text{\omnameExamples}}%
    \Crefname{example}{\text{\omnameExample}}{\text{\omnameExamples}}%
    \crefname{notation}{\text{\omnameNotation}}{\text{\omnameNotations}}%
    \Crefname{notation}{\text{\omnameNotation}}{\text{\omnameNotations}}%
    \crefname{remark}{\text{\omnameRemark}}{\text{\omnameRemarks}}%
    \Crefname{remark}{\text{\omnameRemark}}{\text{\omnameRemarks}}%
    \crefname{exercise}{\text{\omnameExercise}}{\text{\omnameExercises}}%
    \Crefname{exercise}{\text{\omnameExercise}}{\text{\omnameExercises}}%
    \crefname{problem}{\text{\omnameProblem}}{\text{\omnameProblems}}%
    \Crefname{problem}{\text{\omnameProblem}}{\text{\omnameProblems}}%
    \crefname{section}{\text{\omnameSection}}{\text{\omnameSections}}%
    \Crefname{section}{\text{\omnameSection}}{\text{\omnameSections}}%
    \crefformat{chapter}{#2第~#1~章#3}%
    \crefformat{section}{#2第~#1~节#3}%
    \Crefformat{section}{#2第~#1~节#3}%
    \crefmultiformat{section}{#2第~#1~节#3}{和#2第~#1~节#3}{、#2第~#1~节#3}{和#2第~#1~节#3}%
    \Crefformat{chapter}{#2第~#1~章#3}%
    \crefrangeformat{chapter}{#3第~#1~章#4至#5第~#2~章#6}%
    \crefmultiformat{chapter}{#2第~#1~章#3}{和#2第~#1~章#3}{、#2第~#1~章#3}{和#2第~#1~章#3}%
    \renewcommand{\crefpairconjunction}{和}%
    \renewcommand{\crefmiddleconjunction}{、}%
    \renewcommand{\creflastconjunction}{和}%
    \renewcommand{\crefpairgroupconjunction}{和}%
    \renewcommand{\crefmiddlegroupconjunction}{、}%
    \renewcommand{\creflastgroupconjunction}{和}%
    \renewcommand{\crefrangeconjunction}{至}%
    \renewcommand{\crefrangepreconjunction}{}%
    \renewcommand{\crefrangepostconjunction}{}%
  }%
  % ToC page-number box: three Latin Modern digits fit, but leave room.
  \renewcommand{\@pnumwidth}{2.2em}%
  \renewcommand{\@tocrmarg}{3.2em}%
\fi

% (from the CS series) No typewriter ligatures, so that \code{a << 2} prints << and not a guillemet (T1 lmtt
% turns << and >> into « and »). pdfTeX only; the listings are unaffected.
\ifpdftex
  \DisableLigatures[<,>]{encoding = T1, family = tt*}
\fi

% (from the CS series) No hyphen ligatures in typewriter type either: \code{--it} and \code{cargo build --release}
% printed an en dash (T1 lmtt turns -- into one). Repeats Book 2's < and > so the set stays whole.
\ifpdftex
  \DisableLigatures[<,>,-]{encoding = T1, family = tt*}
\fi

% (from the CS series) The weekend-problem look-ahead above saw only blank lines, but every chapter writes
% \section{Problem: ...}\label{sec:...:problem} and then \begin{problem}: the \label stopped the
% look-ahead, the page broke after the heading, and the heading was left alone at a page's foot.
% The look-ahead now also steps over \label{...} arguments and emits them after the heading.
\def\om@sec@grab#1#2{%
  \def\om@sec@emit{#1{#2}}\let\om@sec@pars\@empty\let\om@sec@lbls\@empty\om@sec@peek}
\def\om@sec@peek{\@ifnextchar\par{\om@sec@eatpar}%
  {\@ifnextchar\label{\om@sec@eatlabel}%
  {\@ifnextchar\begin{\om@sec@checkbegin}{\om@sec@emit\om@sec@lbls\om@sec@pars}}}}
\def\om@sec@eatlabel\label#1{\g@addto@macro\om@sec@lbls{\label{#1}}\om@sec@peek}
\def\om@sec@checkbegin\begin#1{%
  \def\om@tmp{#1}%
  \ifx\om@tmp\om@str@problem\clearpage\global\om@problemsectrue\fi
  \om@sec@emit\om@sec@lbls\om@sec@pars\begin{#1}}

% (from the CS series) Keep a short listing or output whole: put
% \Needspace*{N\baselineskip} before a top-level \omcode / \omoutput of at
% most 10 lines, so a 3-line output no longer leaves its last line and caption
% on the next page.
\RequirePackage{needspace}

% (from the CS series) Listings print the Greek epsilon and the empty-set sign in Rust
% listings and their outputs; pdflatex's listings needs them as literate replacements (the
% three earlier ones are kept).
\lstset{literate={~}{{\textasciitilde}}1 {é}{{\'e}}1 {ê}{{\^e}}1 {ε}{{$\varepsilon$}}1 {∅}{{$\emptyset$}}1}

% (from the CS series) The same two signs in outputs too: style omout applies style=om, which carried the old
% literate list, so the style om is redefined here with the longer list (every other key unchanged).
\lstdefinestyle{om}{%
  basicstyle=\ttfamily\footnotesize, columns=fullflexible, keepspaces=true,
  keywordstyle=\color{omDef}\bfseries, commentstyle=\color{omMeth}\itshape,
  stringstyle=\color{omThm}, numberstyle=\tiny\color{omExo}, numbers=left,
  numbersep=6pt, xleftmargin=16pt, framexleftmargin=14pt,
  frame=l, framerule=2pt, rulecolor=\color{omCode},
  backgroundcolor=\color{omCode!4!white},
  showstringspaces=false, breaklines=true, breakatwhitespace=true,
  tabsize=4, upquote=true, aboveskip=6pt, belowskip=4pt,
  captionpos=b, literate={~}{{\textasciitilde}}1 {é}{{\'e}}1 {ê}{{\^e}}1 {ε}{{$\varepsilon$}}1
    {∅}{{$\emptyset$}}1 }

% Book 2: shaded periods on a time chart, read from a figdata CSV with columns start,end (decimal years), drawn
% inside an axis before the plots: \omshadeperiods{figdata/.../out/recessions.csv}. The bands span the full height.
\newcommand{\omshadeperiods}[1]{%
  \pgfplotstableread[col sep=comma]{#1}\om@periods
  \pgfplotstablegetrowsof{\om@periods}%
  \pgfmathtruncatemacro{\om@nper}{\pgfplotsretval-1}%
  \pgfplotsforeachungrouped \om@i in {0,...,\om@nper}{%
    \pgfplotstablegetelem{\om@i}{start}\of{\om@periods}\let\om@ps\pgfplotsretval
    \pgfplotstablegetelem{\om@i}{end}\of{\om@periods}\let\om@pe\pgfplotsretval
    \edef\om@tmp{\noexpand\fill[gray!22] ({axis cs:\om@ps,1}|-{rel axis cs:0,0}) rectangle ({axis cs:\om@pe,1}|-{rel axis cs:0,1});}%
    \om@tmp}}
