  fonttitle=\small\bfseries, toptitle=0.6mm, bottomtitle=0.4mm,
  left=6pt, right=6pt, top=4pt, bottom=4pt,
  before skip=10pt, after skip=10pt}}
\newtcolorbox{recall}{om@aside=omRecall, title={\omnameRecall}}
